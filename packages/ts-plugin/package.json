{
  "name": "@owlsql/ts-plugin",
  "version": "0.1.0",
  "description": "Editor autocomplete, hover info, and live diagnostics for OwlSQL query strings.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "test:runtime": "vitest run",
    "test": "npm run test:types && npm run test:runtime",
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run test && npm run build"
  },
  "peerDependencies": {
    "typescript": ">=5.4.0 <7"
  },
  "keywords": [
    "owlsql",
    "typescript",
    "tsserver-plugin",
    "language-service",
    "sql",
    "autocomplete"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiagolauer/OwlSQL.git",
    "directory": "packages/ts-plugin"
  },
  "homepage": "https://github.com/tiagolauer/OwlSQL/tree/master/packages/ts-plugin#readme",
  "bugs": {
    "url": "https://github.com/tiagolauer/OwlSQL/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
